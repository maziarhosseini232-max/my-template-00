# ==========================================
# Lumina Learn — Production Environment Variables
# Configuration Template for Liara PaaS & Node.js Production
# ==========================================

# 1. Server & Port Configuration
# Liara and container proxy default port
PORT=3000
NODE_ENV="production"

# 2. Database Connection (Liara PostgreSQL / Cloud SQL)
# Example: postgres://root:password@hostname.iran.liara.ir:3306/lumina_db
DATABASE_URL=""

# 3. Security & Authentication
# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=""

# 4. Domain & URL Configuration
# Primary domain for payment gateway callbacks and CORS
SITE_URL="https://luminalearn.ir"
CLIENT_URL="https://luminalearn.ir"
APP_URL="https://luminalearn.ir"
ALLOWED_ORIGINS="https://luminalearn.ir,https://www.luminalearn.ir"

# 5. Payment Gateway (ZarinPal & Shaparak)
# 36-character Merchant ID provided by ZarinPal portal
ZARINPAL_MERCHANT_ID=""

# Set to 'false' for real transactions via live Shaparak gateway, or 'true' for local MockGateway sandbox testing
ZARINPAL_SANDBOX="false"

# 6. AI Features (Optional / Google AI Studio)
GEMINI_API_KEY=""

